---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { teacherResources } from '../../data/media';
---

<Base
  title="Teacher Resources"
  description="Sri Sathya Sai Media Centre listening curated for NDSAI Bal Vikas teachers, grouped by theme — human values, ceiling on desires, pathways to God and more."
>
  <PageHero
    eyebrow="Bal Vikas"
    title="Teacher resources"
    lede="Curated listening from the Sri Sathya Sai Media Centre, gathered for our Bal Vikas teachers."
  />

  <Section width="narrow">
    <div class="reveal rounded-2xl bg-sand-100 p-7">
      <p class="leading-relaxed text-ink-700">
        With humble pranams at Swami’s Lotus Feet, this is a list of external resources from the Sri Sathya Sai Media
        Centre website that have been curated for use by NDSai Bal Vikas teachers for inspiration. There are snippets
        in many of the items that may be relevant across the entire Bal Vikas programme.
      </p>
      <p class="mt-4 leading-relaxed text-ink-700">
        This is primarily intended for teachers’ use. If audio is used in class or during parent participation
        sessions, teachers are encouraged to note down timestamps and play only specific snippets.
      </p>
    </div>

    <div class="mt-12 space-y-10">
      {
        teacherResources.map((group) => (
          <section class="reveal">
            <h2 class="font-display text-2xl font-semibold">{group.heading}</h2>
            <ul class="mt-4 divide-y divide-sand-200 overflow-hidden rounded-2xl bg-white ring-1 ring-sand-200">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex flex-wrap items-baseline gap-x-3 gap-y-1 px-5 py-4 transition-colors hover:bg-sand-100"
                  >
                    <span class="min-w-40 text-sm font-semibold text-indigo-ink-900">{item.label}</span>
                    <span class="flex-1 text-sm text-ink-700 group-hover:text-saffron-700">{item.title}</span>
                    <svg
                      class="h-3.5 w-3.5 shrink-0 text-ink-700 opacity-50 transition-opacity group-hover:opacity-100"
                      viewBox="0 0 14 14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path d="M5 3h6v6M11 3 3.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="reveal mt-12 text-sm text-ink-700">
      All links open on
      <a
        href="https://www.sssmediacentre.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-saffron-700 underline underline-offset-4">sssmediacentre.org</a
      >, which is maintained independently of this center.
    </p>
  </Section>
</Base>
