---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Quote from '../../components/Quote.astro';
---

<Base
  title="Veda Classes"
  description="Veda chanting taught at the center for over a decade by an alumni parent, open to Bal Vikas children in 4th grade and above."
>
  <PageHero
    eyebrow="Bal Vikas"
    title="Veda classes"
    lede="An effort to sustain our ancient scriptures by training children to chant them with discipline — and to spread positive vibrations even as they learn."
  />

  <Section width="narrow">
    <div class="grid gap-8 sm:grid-cols-3">
      {
        [
          { label: 'Who', value: '4th grade and above' },
          { label: 'When', value: '11:15 am – 12:15 pm' },
          { label: 'Taught by', value: 'Mahendraji, alumni parent' },
        ].map((item) => (
          <div class="reveal rounded-2xl bg-white px-5 py-6 ring-1 ring-sand-200">
            <p class="text-[0.68rem] font-semibold tracking-[0.14em] text-saffron-700 uppercase">{item.label}</p>
            <p class="mt-2 font-display text-xl font-semibold text-indigo-ink-900">{item.value}</p>
          </div>
        ))
      }
    </div>

    <div class="rich reveal mt-12">
      <p>
        Mahendraji, a parent of one of our alumni, has been teaching Vedas to Bal Vikas children for over a decade.
        Classes are held so that children can attend during the time when their own Bal Vikas class is not in session.
      </p>
      <p>
        Swami emphasised the importance of <em>Veda Samrakshanam</em> — the protection of the Vedas — in many
        discourses, as well as by being an exemplar. Our Veda classes are inspired by that: an effort to sustain our
        ancient scriptures by training our children to chant them with discipline, while spreading positive vibrations
        even as they learn and practise.
      </p>
    </div>

    <figure class="reveal mt-12">
      <img
        src="/img/veda/veda-students-stage.webp"
        alt="Bal Vikas students in white and saffron dhotis standing in a line on stage with hands folded, chanting"
        width="1400"
        height="787"
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl shadow-xl shadow-indigo-ink-900/10"
      />
      <figcaption class="mt-3 text-sm text-ink-700">
        Veda students chanting at a center programme.
      </figcaption>
    </figure>
  </Section>

  <Section width="narrow" tone="sand" class="!pt-0 !mt-16">
    <Quote size="large">
      The Vedas are for all mankind; they have prayers for peace subjugating the anger of the elements and of human
      communities.
    </Quote>

    <figure class="reveal mt-12">
      <img
        src="/img/veda/swami-veda-class.webp"
        alt="Children seated with Bhagawan Sri Sathya Sai Baba during a Veda class"
        width="1000"
        height="700"
        loading="lazy"
        decoding="async"
        class="mx-auto w-full max-w-lg rounded-2xl shadow-lg shadow-indigo-ink-900/10"
      />
      <figcaption class="mt-3 text-center text-sm text-ink-700">
        Children with Bhagawan Sri Sathya Sai Baba during Veda classes.
      </figcaption>
    </figure>
  </Section>
</Base>
