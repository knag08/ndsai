---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { academicYear, blocks, keyDates } from '../../data/calendar';

/**
 * How each kind of session reads at a glance. Holidays are muted rather than
 * hidden — "there is no class on the 6th, it's Labor Day" is exactly what a
 * parent opens this page to find out.
 */
const kinds = {
  orientation: { dot: 'bg-saffron-500', text: 'text-indigo-ink-900' },
  class: { dot: 'bg-indigo-ink-300', text: 'text-ink-700' },
  presentation: { dot: 'bg-saffron-500', text: 'text-indigo-ink-900' },
  seva: { dot: 'bg-indigo-ink-600', text: 'text-indigo-ink-900' },
  celebration: { dot: 'bg-saffron-400', text: 'text-indigo-ink-900' },
  holiday: { dot: 'bg-sand-300', text: 'text-ink-700' },
  casting: { dot: 'bg-saffron-300', text: 'text-indigo-ink-900' },
  practice: { dot: 'bg-indigo-ink-300', text: 'text-ink-700' },
  rehearsal: { dot: 'bg-saffron-400', text: 'text-indigo-ink-900' },
  performance: { dot: 'bg-saffron-500', text: 'text-indigo-ink-900' },
} as const;

const totalClasses = blocks
  .flatMap((block) => block.sessions)
  .filter((session) => session.kind === 'class').length;
---

<Base
  title={`Calendar ${academicYear}`}
  description={`Bal Vikas class dates for ${academicYear} — six units of Sunday classes, presentations and seva, the holidays in between, and the Easwaramma Day programme that closes the year.`}
>
  <PageHero
    eyebrow={`Academic year ${academicYear}`}
    title="Bal Vikas calendar"
    lede="Classes meet on Sunday mornings. Six units of teaching, each closing with a presentation and a service project, and then the Easwaramma Day programme through April and early May."
  />

  <Section width="wide">
    <!--
      Filled in by the script at the foot of this page rather than at build time.
      The site is static, so a "next session" worked out during the build would
      be wrong for every visitor until somebody happened to deploy again.
    -->
    <div
      id="next-session"
      hidden
      class="reveal mb-10 flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-2xl border-l-4 border-saffron-500 bg-saffron-50 px-6 py-5"
    >
      <span class="text-[0.68rem] font-semibold tracking-[0.14em] text-saffron-700 uppercase">Next session</span>
      <strong id="next-session-date" class="font-display text-xl font-semibold text-indigo-ink-900"></strong>
      <span id="next-session-what" class="text-ink-700"></span>
    </div>

    <div class="grid items-start gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        blocks.map((block) => (
          <article
            class="reveal overflow-hidden rounded-2xl bg-white ring-1 ring-sand-200"
            data-block
            data-from={block.sessions[0].iso}
            data-to={block.sessions[block.sessions.length - 1].iso}
          >
            <header class="flex items-baseline justify-between gap-3 bg-indigo-ink-900 px-6 py-4" data-block-header>
              <div>
                <h2 class="font-display text-xl font-semibold !text-white">{block.title}</h2>
                {block.subtitle && <p class="mt-0.5 text-sm text-saffron-300">{block.subtitle}</p>}
              </div>
              <span
                class="hidden shrink-0 rounded-full bg-white/20 px-2.5 py-1 text-[0.62rem] font-bold tracking-[0.1em] text-white uppercase"
                data-current-badge
              >
                Now
              </span>
            </header>

            <ol class="divide-y divide-sand-200">
              {block.sessions.map((session) => (
                <li
                  class:list={[
                    'flex items-baseline gap-3 px-6 py-3',
                    session.kind === 'holiday' && 'bg-sand-50',
                  ]}
                  data-session
                  data-iso={session.iso}
                >
                  <span class:list={['mt-1.5 h-2 w-2 shrink-0 rounded-full', kinds[session.kind].dot]} />
                  <div class="min-w-0 flex-1">
                    <p class:list={['text-sm font-semibold', kinds[session.kind].text]}>{session.label}</p>
                    {session.note && (
                      <p
                        class:list={[
                          'mt-0.5 text-xs',
                          session.kind === 'holiday' ? 'text-saffron-700' : 'text-ink-700',
                        ]}
                      >
                        {session.note}
                      </p>
                    )}
                  </div>
                  <time
                    datetime={session.iso}
                    class:list={[
                      'shrink-0 text-right text-sm tabular-nums',
                      session.kind === 'holiday' ? 'text-ink-700' : 'font-semibold text-indigo-ink-900',
                    ]}
                  >
                    {session.date.replace(`, ${session.iso.slice(0, 4)}`, '')}
                    <span class="mt-0.5 block text-[0.68rem] font-normal text-ink-700">
                      {session.day.slice(0, 3)}
                    </span>
                  </time>
                </li>
              ))}
            </ol>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-10 grid items-start gap-6 lg:grid-cols-2">
      <div class="rounded-2xl bg-indigo-ink-900 p-7">
        <h2 class="font-display text-2xl font-semibold !text-white">Dates to keep free</h2>
        <ul class="mt-5 space-y-5">
          {
            keyDates.map((event) => (
              <li class="border-b border-white/10 pb-5 last:border-0 last:pb-0">
                <time datetime={event.iso} class="font-display text-lg font-semibold text-saffron-300">
                  {event.date}
                </time>
                <p class="mt-1 font-semibold text-white">{event.title}</p>
                <p class="mt-1 text-sm text-indigo-ink-200">{event.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl bg-sand-100 p-7">
        <h2 class="font-display text-2xl font-semibold">How the year runs</h2>
        <ul class="rich mt-4">
          <li><strong>Classes</strong> — {totalClasses} Sunday teaching sessions across the six units.</li>
          <li><strong>Presentation</strong> — students present what they have learned to the group.</li>
          <li><strong>Seva</strong> — a service project closes each unit, putting the theme into action.</li>
          <li>
            <strong>Unit 6</strong> — the Easwaramma Day programme: casting, then practices on Saturdays and Sundays
            through April, a stage rehearsal on Friday May 7, and the programme itself on Sunday May 9.
          </li>
        </ul>
        <p class="mt-5 text-sm text-ink-700">
          Parents also take part as partners during each unit. Those dates are arranged within the class, so your
          child’s teacher will confirm them — as they will any change to the dates above.
        </p>
      </div>
    </div>
  </Section>
</Base>

<script>
  // Works out what is next in the reader's own time, so the page stays right
  // however long it has been since the site was last deployed.
  const today = new Date();
  const iso = [
    today.getFullYear(),
    String(today.getMonth() + 1).padStart(2, '0'),
    String(today.getDate()).padStart(2, '0'),
  ].join('-');

  const sessions = Array.from(document.querySelectorAll<HTMLElement>('[data-session]'));
  const upcoming = sessions.find((el) => (el.dataset.iso ?? '') >= iso);

  if (upcoming) {
    upcoming.classList.add('bg-saffron-50');

    const label = upcoming.querySelector('p')?.textContent?.trim() ?? '';
    const when = upcoming.querySelector('time');

    const banner = document.getElementById('next-session');
    const date = document.getElementById('next-session-date');
    const what = document.getElementById('next-session-what');

    if (banner && date && what && when) {
      const parsed = new Date(`${upcoming.dataset.iso}T12:00:00`);
      date.textContent = parsed.toLocaleDateString(undefined, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      });
      what.textContent = upcoming.dataset.iso === iso ? `Today — ${label}` : label;
      banner.hidden = false;
    }
  }

  // Mark the unit the year is currently in.
  for (const block of document.querySelectorAll<HTMLElement>('[data-block]')) {
    const { from = '', to = '' } = block.dataset;
    if (iso < from || iso > to) continue;
    block.classList.remove('ring-sand-200');
    block.classList.add('ring-2', 'ring-saffron-400', 'shadow-lg', 'shadow-saffron-500/10');
    block.querySelector('[data-block-header]')?.classList.replace('bg-indigo-ink-900', 'bg-saffron-500');
    block.querySelector('[data-current-badge]')?.classList.remove('hidden');
  }
</script>
