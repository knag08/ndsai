---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { academicYear, mandatoryEvents, units } from '../../data/calendar';

/** Highlight the unit that contains today, so families land on the right one. */
const today = new Date().toISOString().slice(0, 10);
const currentUnit = units.find((unit) => {
  const dates = unit.sessions.map((session) => session.iso);
  return today >= dates[0] && today <= dates[dates.length - 1];
})?.unit;
---

<Base
  title={`Calendar ${academicYear}`}
  description={`Bal Vikas class dates for ${academicYear} — six units, each with three classes, a parent participation session, a presentation and a seva.`}
>
  <PageHero
    eyebrow={`Academic year ${academicYear}`}
    title="Bal Vikas calendar"
    lede="The year runs in six units. Each unit has three teaching classes, a parent participation session, a unit presentation, and a service project."
  />

  <Section width="wide">
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        units.map((unit) => {
          const isCurrent = unit.unit === currentUnit;
          return (
            <article
              class:list={[
                'reveal overflow-hidden rounded-2xl bg-white ring-1 transition-shadow',
                isCurrent ? 'ring-2 ring-saffron-400 shadow-lg shadow-saffron-500/10' : 'ring-sand-200',
              ]}
            >
              <header
                class:list={[
                  'flex items-center justify-between gap-3 px-6 py-4',
                  isCurrent ? 'bg-saffron-500' : 'bg-indigo-ink-900',
                ]}
              >
                <h2 class="font-display text-xl font-semibold !text-white">Unit {unit.unit}</h2>
                {isCurrent && (
                  <span class="rounded-full bg-white/20 px-2.5 py-1 text-[0.62rem] font-bold tracking-[0.1em] text-white uppercase">
                    Current
                  </span>
                )}
              </header>

              <dl class="divide-y divide-sand-200">
                {unit.sessions.map((session) => (
                  <div class="flex items-baseline justify-between gap-4 px-6 py-3">
                    <dt class="text-sm text-ink-700">{session.label}</dt>
                    <dd class="text-right text-sm font-semibold text-indigo-ink-900">
                      <time datetime={session.iso}>{session.date}</time>
                    </dd>
                  </div>
                ))}
              </dl>
            </article>
          );
        })
      }
    </div>

    <div class="reveal mt-10 grid items-start gap-6 lg:grid-cols-2">
      <div class="rounded-2xl bg-indigo-ink-900 p-7">
        <h2 class="font-display text-2xl font-semibold !text-white">Mandatory center events</h2>
        <ul class="mt-5 space-y-4">
          {
            mandatoryEvents.map((event) => (
              <li class="flex items-baseline gap-4 border-b border-white/10 pb-4 last:border-0 last:pb-0">
                <time datetime={event.iso} class="shrink-0 font-display text-lg font-semibold text-saffron-300">
                  {event.date}
                </time>
                <span class="text-indigo-ink-100">{event.title}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl bg-sand-100 p-7">
        <h2 class="font-display text-2xl font-semibold">How a unit works</h2>
        <ul class="rich mt-4">
          <li><strong>Classes 1–3</strong> — the teaching sessions for the unit theme.</li>
          <li><strong>Parent participation</strong> — parents join the class as partners, once every unit.</li>
          <li><strong>Presentation</strong> — students present what they have learned to the group.</li>
          <li><strong>Seva</strong> — a service project closes the unit, putting the theme into action.</li>
        </ul>
        <p class="mt-5 text-sm text-ink-700">
          The Bal Vikas calendar follows the PISD school calendar. Dates can shift; your child’s teacher will confirm
          any change.
        </p>
      </div>
    </div>
  </Section>
</Base>
