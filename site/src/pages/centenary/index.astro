---
import Base from '../../layouts/Base.astro';
---

<Base
  title="One Hundred Years"
  description="Explore one hundred years of Bhagawan Sri Sathya Sai Baba, with messages and stories from His teachings."
  image="/img/centenary/centenary-emblem.webp"
  noindex
>
  <main class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
    <h1 class="font-display text-3xl font-semibold text-indigo-ink-900">Continue to 100 Years</h1>
    <p class="mt-4 text-ink-700">
      <a class="font-semibold text-indigo-ink-900 underline" href="/centenary/timeline/">Open 100 Years</a>
      <span class="mx-2">or</span>
      <a class="font-semibold text-indigo-ink-900 underline" href="/centenary/messages/">Open 100 Messages</a>
    </p>
  </main>

  <script is:inline>
    const destination = new URLSearchParams(location.search).has('m')
      ? `/centenary/messages/${location.search}${location.hash}`
      : '/centenary/timeline/';
    location.replace(destination);
  </script>
</Base>
