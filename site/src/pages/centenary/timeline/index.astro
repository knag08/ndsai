---
/**
 * One hundred years, one moment to a card, swiped left and right.
 *
 * The same deck as the facts page — see `createDeck` in scripts/centenary.ts —
 * with one deliberate difference: these cards are never shuffled. The order is
 * the point. Swiping left to right walks a visitor through the century, and the
 * bar underneath fills as the years pass.
 *
 * Text only, by choice: the photographs available for these events are small,
 * and a soft upscaled picture would say less than the words do.
 */
import Base from '../../../layouts/Base.astro';
import CentenaryLinks from '../../../components/CentenaryLinks.astro';
import { eras, momentCount } from '../../../data/timeline';

/** Flattened in order, each moment carrying the era it belongs to. */
const moments = eras.flatMap((era) => era.moments.map((moment) => ({ ...moment, era: era.title })));
---

<Base
  title="One Hundred Years"
  description="The life of Bhagawan Sri Sathya Sai Baba, year by year — from a thatched house in Puttaparthi in 1926 to the schools, hospitals and water that followed."
  image="/img/centenary/centenary-emblem.webp"
>
  <section class="relative isolate overflow-hidden bg-indigo-ink-900">
    <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-saffron-500 via-saffron-300 to-saffron-500"></div>

    <CentenaryLinks here="timeline" />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 left-1/2 -z-10 h-[46rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(238,148,56,0.26),rgba(238,148,56,0))]"
    >
    </div>

    <div class="deck-shell mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-12">
      <div class="present-hide text-center">
        <img
          src="/img/centenary/centenary-emblem.webp"
          alt="Centenary emblem marking one hundred years of Bhagawan Sri Sathya Sai Baba"
          width="900"
          height="900"
          class="mx-auto w-24 sm:w-28"
          loading="eager"
          fetchpriority="high"
        />
        <h1 class="mt-3 font-display text-3xl font-semibold !text-white sm:text-5xl">One hundred years</h1>
      </div>

      <div
        id="timeline-deck"
        class="deck mt-6"
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label="One hundred years, one moment to a card"
      >
        {
          moments.map((moment, index) => (
            <article
              class:list={['deck-card', moment.major && 'is-major', index === moments.length - 1 && 'is-finale']}
              role="group"
              aria-roledescription="slide"
              aria-label={`${moment.year}, ${index + 1} of ${moments.length}`}
            >
              <div class:list={['deck-card-inner', moment.image && 'has-image']}>
                <span class="sparkles" aria-hidden="true">
                  {Array.from({ length: index === moments.length - 1 ? 14 : 7 }).map((_, n) => (
                    <span class={`sparkle sparkle-${n + 1}`} />
                  ))}
                </span>
                {
                  moment.image && (
                    <img
                      class="card-image"
                      src={moment.image}
                      alt={moment.alt}
                      width={moment.imageWidth}
                      height={moment.imageHeight}
                      loading={index < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  )
                }

                <div class="card-text">
                  <p class="card-era">{moment.era}</p>

                  <p class="card-year">
                  <span class="card-year-number">{moment.year}</span>
                  {moment.when && <span class="card-when">{moment.when}</span>}
                </p>

                  <h2 class="card-title">{moment.title}</h2>
                  <p class="card-body">{moment.body}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div id="deck-controls" class="deck-controls mt-6" hidden>
        <button type="button" id="deck-prev" class="deck-button" aria-label="Earlier">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <button type="button" id="deck-play" class="deck-button" aria-pressed="true" title="Pause">
          <span class="sr-only" id="deck-play-label">Pause</span>
          <svg id="deck-play-icon" class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <rect x="4.5" y="3.5" width="2.5" height="9" rx="0.6" />
            <rect x="9" y="3.5" width="2.5" height="9" rx="0.6" />
          </svg>
        </button>

        <p class="deck-counter" role="status" aria-live="polite">
          <span id="deck-position">1</span><span class="text-indigo-ink-400"> / {moments.length}</span>
        </p>

        <button type="button" id="deck-present" class="deck-button" title="Present full screen">
          <span class="sr-only">Present full screen</span>
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M2.5 6V3.5a1 1 0 0 1 1-1H6m4 0h2.5a1 1 0 0 1 1 1V6m0 4v2.5a1 1 0 0 1-1 1H10m-4 0H3.5a1 1 0 0 1-1-1V10"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>

        <button type="button" id="deck-next" class="deck-button" aria-label="Later">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>

      <!-- The bar reads as the century: 1926 at one end, 2026 at the other. -->
      <div class="mt-5">
        <div class="deck-progress" aria-hidden="true">
          <div class="deck-progress-bar" id="deck-progress-bar"></div>
        </div>
        <div class="mt-2 flex justify-between text-[0.7rem] font-semibold tracking-[0.12em] text-indigo-ink-400 tabular-nums">
          <span>1926</span>
          <span>2026</span>
        </div>
      </div>

      <p class="present-hide mt-6 text-center text-xs leading-relaxed text-indigo-ink-300">
        Dates and events are drawn from the life history and project records published by the
        <a
          href="https://www.srisathyasai.org/pages/sai-life-history-timeline.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-indigo-ink-200 underline decoration-white/30 underline-offset-2 hover:text-saffron-300"
          >Sri Sathya Sai Central Trust</a
        >, which tells each of them at far greater length than there is room for here.
      </p>

    </div>
  </section>

  <style>
    /* ------------------------------------------------------------ the deck */

    .deck {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* Room for the focus ring, which the overflow would otherwise clip. */
      padding: 0.25rem;
      margin-inline: -0.25rem;
    }

    .deck::-webkit-scrollbar {
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .deck {
        scroll-behavior: auto;
      }
    }

    .deck-card {
      flex: 0 0 100%;
      scroll-snap-align: center;
    }

    .deck-card-inner {
      display: flex;
      flex-direction: column;
      /* Centred, because the cards are a fixed height and the entries are not:
         a two-line one would otherwise sit marooned at the top of the card. */
      justify-content: center;
      height: 100%;
      /* Every card the same height, so the page does not jump as you swipe. */
      min-height: 19rem;
      border-radius: 1.5rem;
      background: rgb(255 255 255 / 0.1);
      box-shadow:
        inset 0 0 0 1px rgb(255 255 255 / 0.2),
        0 12px 30px rgb(10 14 36 / 0.35);
      padding: 1.5rem 1.25rem;
    }

    @media (min-width: 640px) {
      .deck-card-inner {
        min-height: 19rem;
        padding: 2.5rem;
      }
    }

    /* The twelve moments the century turns on get a saffron edge. */
    .deck-card.is-major .deck-card-inner {
      box-shadow:
        inset 0 0 0 1px rgb(238 148 56 / 0.5),
        0 12px 30px rgb(10 14 36 / 0.35);
    }

    /*
      The pictures are shown whole: never cropped, never scaled up, never forced
      to a shape. They arrive in everything from 0.66 (a portrait magazine
      cover) to 2.16 (a panorama), so bounding BOTH sides and letting the
      browser work out the rest is the only thing that holds for all of them.
      An earlier version fixed the height and let `cover` take up the slack,
      which turned a 4:3 painting into a letterbox strip and cut the subject's
      head off.
    */
    .card-image {
      display: block;
      margin: 0 auto 1.1rem;
      max-width: 100%;
      max-height: 13.5rem;
      width: auto;
      height: auto;
      border-radius: 0.875rem;
      background: rgb(255 255 255 / 0.06);
    }

    @media (min-width: 640px) {
      .card-image {
        max-height: 15rem;
      }
    }

    /*
      On a wide card, stacking wastes the width and makes the card taller than
      the screen. Side by side instead: the picture holds one column and the
      words sit beside it.
    */
    @media (min-width: 768px) {
      .deck-card-inner.has-image {
        display: grid;
        grid-template-columns: 20rem 1fr;
        align-items: center;
        column-gap: 2rem;
      }

      .has-image .card-image {
        max-height: 16rem;
        margin: 0 auto;
      }

      .has-image .card-text {
        min-width: 0;
      }
    }

    .card-era {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-indigo-ink-300);
    }

    .card-year {
      margin-top: 0.9rem;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.6rem;
    }

    .card-year-number {
      font-family: var(--font-display);
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1;
      color: var(--color-saffron-400);
      /* Cormorant sets figures old-style by default, which turns a year into a
         row of squiggles. These have to read as numbers. */
      font-variant-numeric: lining-nums;
    }

    .card-when {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-indigo-ink-200);
    }

    .card-title {
      margin-top: 0.75rem;
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 600;
      line-height: 1.25;
      color: #fff;
    }

    .card-body {
      margin-top: 0.75rem;
      font-size: 1.02rem;
      line-height: 1.65;
      color: var(--color-indigo-ink-100);
    }

    @media (min-width: 640px) {
      .card-title {
        font-size: 1.9rem;
      }

      .card-body {
        font-size: 1.1rem;
      }
    }

    /* ----------------------------------------------------------- the stars */

    .deck-card-inner {
      position: relative;
      overflow: hidden;
    }

    .sparkles {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    /*
      A four-pointed star rather than a dot. `clip-path` cuts the shape out of
      the box, so the glow has to come from `drop-shadow`, which follows the
      clipped silhouette — a `box-shadow` would be clipped away with the rest.
    */
    .sparkle {
      position: absolute;
      width: 10px;
      height: 10px;
      background: var(--color-saffron-200);
      clip-path: polygon(
        50% 0%, 60% 40%, 100% 50%, 60% 60%,
        50% 100%, 40% 60%, 0% 50%, 40% 40%
      );
      filter: drop-shadow(0 0 4px rgb(243 177 100 / 0.85));
      opacity: 0;
    }

    /*
      Only the card in view twinkles. Fifty-two cards' worth of animation
      running at once is work a phone does not need to do for cards nobody can
      see, and the deck's `onChange` moves `is-current` along as you go.
    */
    .deck-card.is-current .sparkle {
      animation-name: twinkle;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }

    /* Placed by hand so the scatter is even and the same on every reload. */
    .sparkle-1  { top: 11%; left: 7%;  animation-duration: 3.1s; animation-delay: 0.0s; }
    .sparkle-2  { top: 27%; left: 93%; animation-duration: 2.6s; animation-delay: 0.5s; }
    .sparkle-3  { top: 69%; left: 4%;  animation-duration: 3.4s; animation-delay: 1.0s; }
    .sparkle-4  { top: 85%; left: 79%; animation-duration: 2.9s; animation-delay: 1.4s; }
    .sparkle-5  { top: 7%;  left: 55%; animation-duration: 3.6s; animation-delay: 0.3s; }
    .sparkle-6  { top: 45%; left: 96%; animation-duration: 2.4s; animation-delay: 1.8s; }
    .sparkle-7  { top: 91%; left: 33%; animation-duration: 3.2s; animation-delay: 0.8s; }
    .sparkle-8  { top: 20%; left: 23%; animation-duration: 2.8s; animation-delay: 2.1s; }
    .sparkle-9  { top: 58%; left: 88%; animation-duration: 3.0s; animation-delay: 1.1s; }
    .sparkle-10 { top: 76%; left: 15%; animation-duration: 2.7s; animation-delay: 0.6s; }
    .sparkle-11 { top: 35%; left: 2%;  animation-duration: 3.5s; animation-delay: 1.9s; }
    .sparkle-12 { top: 4%;  left: 77%; animation-duration: 2.5s; animation-delay: 1.5s; }
    .sparkle-13 { top: 52%; left: 45%; animation-duration: 3.3s; animation-delay: 2.4s; }
    .sparkle-14 { top: 88%; left: 61%; animation-duration: 2.9s; animation-delay: 0.4s; }

    /* Quiet on an ordinary card, so the words stay the point. */
    @keyframes twinkle {
      0%, 100% { opacity: 0; transform: scale(0.35) rotate(0deg); }
      50%      { opacity: 0.5; transform: scale(1) rotate(45deg); }
    }

    /* ------------------------------------------------------------ the finale */

    .deck-card.is-finale .deck-card-inner {
      background:
        radial-gradient(120% 90% at 50% 0%, rgb(238 148 56 / 0.22), transparent 70%),
        rgb(255 255 255 / 0.1);
      box-shadow:
        inset 0 0 0 1px rgb(238 148 56 / 0.65),
        0 12px 34px rgb(10 14 36 / 0.4);
    }

    /* Brighter and larger on the last card, where it is a celebration. */
    .deck-card.is-finale .sparkle {
      width: 13px;
      height: 13px;
      background: var(--color-saffron-100);
      filter: drop-shadow(0 0 6px rgb(243 177 100 / 0.95));
    }

    .deck-card.is-finale.is-current .sparkle {
      animation-name: twinkle-finale;
    }

    @keyframes twinkle-finale {
      0%, 100% { opacity: 0; transform: scale(0.35) rotate(0deg); }
      50%      { opacity: 1; transform: scale(1.15) rotate(45deg); }
    }

    /* Anyone who has asked for less motion gets still stars, lit but quiet. */
    @media (prefers-reduced-motion: reduce) {
      .sparkle {
        animation: none !important;
        opacity: 0.4;
        transform: rotate(45deg);
      }

      .deck-card.is-finale .sparkle {
        opacity: 0.7;
      }
    }

    /* -------------------------------------------------- presenting on a screen */

    /*
      For a screen in the hall: the page chrome goes, the card fills the view
      and the type grows. Driven by a class on <html> rather than the Fullscreen
      API alone, so it still works if a browser refuses to go full screen.
    */
    :global(html.presenting) :global(body > header),
    :global(html.presenting) :global(body > footer),
    :global(html.presenting) :global(.centenary-tabs),
    :global(html.presenting) .present-hide {
      display: none !important;
    }

    :global(html.presenting),
    :global(html.presenting) :global(body) {
      background: var(--color-indigo-ink-950);
    }

    /*
      The shell is the page's reading column, 48rem wide. Presenting has to
      release it: left at 48rem the card keeps that width, and with a fixed
      image column beside it the words are squeezed into a strip barely wide
      enough for one of them.
    */
    :global(html.presenting) .deck-shell {
      max-width: none;
      padding-inline: clamp(1rem, 4vw, 4rem);
      padding-block: clamp(0.75rem, 2.5vh, 2rem);
    }

    :global(html.presenting) .deck-card-inner {
      min-height: min(72vh, 44rem);
      padding: clamp(1.5rem, 3.5vw, 3.5rem);
    }

    :global(html.presenting) .card-year-number {
      font-size: clamp(3rem, 7vw, 6rem);
    }

    :global(html.presenting) .card-title {
      font-size: clamp(1.9rem, 3.6vw, 3.4rem);
    }

    :global(html.presenting) .card-body {
      font-size: clamp(1.1rem, 1.7vw, 1.7rem);
    }

    :global(html.presenting) .card-era,
    :global(html.presenting) .card-when {
      font-size: clamp(0.75rem, 1.1vw, 1.05rem);
    }

    /*
      `.has-image` is carried here only for weight: Astro scopes both selectors
      with an attribute, and without it the plain `.has-image .card-image` rule
      above wins and pins the picture to 16rem on a presentation screen.

      `width: auto` rather than `100%`, so a 624px file is never stretched to
      fill a 750px column — it simply sits at its own size.
    */
    :global(html.presenting) .has-image .card-image,
    :global(html.presenting) .card-image {
      width: auto;
      max-width: 100%;
      max-height: min(46vh, 30rem);
    }

    @media (min-width: 768px) {
      :global(html.presenting) .deck-card-inner.has-image {
        /* Proportional, not fixed: a share of whatever width the screen gives. */
        grid-template-columns: minmax(0, 45%) minmax(0, 1fr);
        column-gap: clamp(1.5rem, 3vw, 3.5rem);
      }
    }

    /* ---------------------------------------------------------- the controls */

    .deck-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
    }

    .deck-button {
      display: inline-flex;
      height: 2.75rem;
      width: 2.75rem;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      color: #fff;
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
      transition: background-color 0.2s ease;
    }

    .deck-button:hover:not(:disabled) {
      background: rgb(255 255 255 / 0.12);
    }

    .deck-button:disabled {
      opacity: 0.3;
    }

    .deck-counter {
      min-width: 5rem;
      text-align: center;
      font-size: 0.85rem;
      font-weight: 600;
      color: #fff;
      font-variant-numeric: tabular-nums;
    }

    .deck-progress {
      height: 2px;
      border-radius: 9999px;
      background: rgb(255 255 255 / 0.12);
    }

    .deck-progress-bar {
      height: 100%;
      width: 1%;
      border-radius: 9999px;
      background: var(--color-saffron-400);
      transition: width 0.25s ease;
    }
  </style>

  <script>
    import { createDeck } from '../../../scripts/centenary';

    const deck = document.getElementById('timeline-deck');
    const controls = document.getElementById('deck-controls');
    const playBtn = document.getElementById('deck-play') as HTMLButtonElement | null;
    const playIcon = document.getElementById('deck-play-icon');
    const playLabel = document.getElementById('deck-play-label');

    const PLAY_PATH = '<path d="M5 3.3v9.4a.6.6 0 0 0 .92.5l7.2-4.7a.6.6 0 0 0 0-1l-7.2-4.7a.6.6 0 0 0-.92.5Z"/>';
    const PAUSE_PATH =
      '<rect x="4.5" y="3.5" width="2.5" height="9" rx="0.6"/><rect x="9" y="3.5" width="2.5" height="9" rx="0.6"/>';

    if (deck) {
      if (controls) (controls as HTMLElement).hidden = false;

      /*
        How long to rest on a card: a base pause plus time for the words on it,
        at a pace for reading a card rather than a page. A card with a picture
        and four lines gets noticeably longer than a two-line one, so the deck
        never moves off something somebody is still reading.

        The constants are tuned so most cards land between seven and ten
        seconds and the ceiling rarely binds: an earlier set left thirty-nine of
        the fifty-two pinned at the cap, which meant the length of a card made
        no difference at all.
      */
      const WORDS_PER_MINUTE = 300;
      const BASE_MS = 2000;
      const MIN_MS = 5000;
      const MAX_MS = 10000;

      const cards = Array.from(deck.children) as HTMLElement[];
      const dwellTimes = cards.map((card) => {
        const words = (card.textContent ?? '').trim().split(/\s+/).filter(Boolean).length;
        const reading = (words / WORDS_PER_MINUTE) * 60 * 1000;
        // A picture is worth a glance of its own before the words are read.
        const looking = card.querySelector('.card-image') ? 700 : 0;
        return Math.round(Math.min(MAX_MS, Math.max(MIN_MS, BASE_MS + reading + looking)));
      });

      const player = createDeck({
        deck,
        prev: document.getElementById('deck-prev'),
        next: document.getElementById('deck-next'),
        position: document.getElementById('deck-position'),
        bar: document.getElementById('deck-progress-bar'),
        // Past 2026, round again to 1926.
        loop: true,
        dwell: (index) => dwellTimes[index] ?? MIN_MS,
        // Only the card in view twinkles; see the stylesheet above.
        onChange: (index) => {
          for (let i = 0; i < cards.length; i++) {
            cards[i].classList.toggle('is-current', i === index);
          }
        },
        onPlayState: (playing) => {
          if (playIcon) playIcon.innerHTML = playing ? PAUSE_PATH : PLAY_PATH;
          if (playLabel) playLabel.textContent = playing ? 'Pause' : 'Play';
          if (playBtn) {
            playBtn.setAttribute('aria-pressed', String(playing));
            playBtn.title = playing ? 'Pause' : 'Play';
          }
        },
      });

      // ------------------------------------------------- presenting on a screen

      const presentBtn = document.getElementById('deck-present');
      const root = document.documentElement;

      function setPresenting(on: boolean): void {
        root.classList.toggle('presenting', on);
        presentBtn?.setAttribute('title', on ? 'Leave full screen' : 'Present full screen');
        // Coming back to a normal page, the card has changed size underneath
        // the deck, so the step between cards has to be measured again.
        window.dispatchEvent(new Event('resize'));
      }

      presentBtn?.addEventListener('click', async () => {
        const leaving = root.classList.contains('presenting');
        try {
          if (leaving) await document.exitFullscreen?.();
          else await root.requestFullscreen?.();
        } catch {
          // Some browsers refuse without a stronger gesture, or on a phone.
          // The layout is worth having either way, so carry on regardless.
        }
        setPresenting(!leaving);
        if (!leaving) player?.resume();
      });

      // Leaving full screen by Escape has to put the page back too.
      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement && root.classList.contains('presenting')) {
          setPresenting(false);
        }
      });

      playBtn?.addEventListener('click', () => {
        if (!player) return;
        if (player.isPlaying()) player.pause();
        else player.resume();
      });

      // Start moving on its own. `resume` does nothing where the reader has
      // asked for reduced motion, and the button then simply reads "Play".
      player?.resume();
      if (player && !player.isPlaying() && playIcon) {
        playIcon.innerHTML = PLAY_PATH;
        if (playLabel) playLabel.textContent = 'Play';
        playBtn?.setAttribute('aria-pressed', 'false');
      }
    }
  </script>
</Base>
