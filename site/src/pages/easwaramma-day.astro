---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Quote from '../components/Quote.astro';
import Lightbox from '../components/Lightbox.astro';
import { easwarammaDay2026 } from '../data/galleries';
---

<Base
  title="Easwaramma Day"
  description="Easwaramma Day 2026 at Frisco High School — Nava Vidha Bhakthi, the nine paths of devotion, presented by Bal Vikas students. Thirty photographs from the day."
  image="/img/easwaramma-2026/ed2026-02.webp"
>
  <PageHero
    eyebrow="May 10, 2026 · Frisco High School"
    title="Easwaramma Day"
    lede="A celebration of the sacred ideal of motherhood, and the largest offering our children make each year."
    image="/img/hero/ed2026-09.webp"
  />

  <Section width="narrow">
    <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr] sm:items-start">
      <div class="rich reveal !mt-0">
        <h2 class="!mt-0">Why we celebrate Easwaramma Day</h2>
        <p>
          May 6th every year is celebrated as Easwaramma Day, commemorating the anniversary of the passing away of the
          saintly lady who was blessed to be mother to the Avatar of the Kali age. Bhagawan exhorts His devotees,
          especially children, to revere the mother as God — and so this day is a celebration of the sacred ideal of
          motherhood.
        </p>
        <p>
          Easwaramma was very fond of children, and was one of the pioneers of the Bal Vikas movement. The day is
          therefore also celebrated as Bal Vikas Day, when hundreds of Bal Vikas children gather to present their
          cultural programmes and imbibe the highest spiritual lessons from their Divine Mother.
        </p>
      </div>

      <figure class="reveal">
        <img
          src="/img/easwaramma/easwaramma-with-swami.webp"
          alt="A sepia photograph of Mother Easwaramma with Bhagawan Sri Sathya Sai Baba"
          width="1000"
          height="780"
          loading="lazy"
          decoding="async"
          class="w-full rounded-2xl shadow-lg shadow-indigo-ink-900/10"
        />
        <figcaption class="mt-3 text-sm text-ink-700">Mother Easwaramma with Bhagawan Sri Sathya Sai Baba.</figcaption>
      </figure>
    </div>
  </Section>

  <Section width="narrow" class="!pt-0">
    <Quote source="Sri Sathya Sai Speaks Vol. 39 / Ch. 8, May 6, 2006">
      The first and foremost duty of every child is to fulfil the wishes of one’s mother and make her happy. Secondly,
      serve all to the extent possible. You need not take up any service activity beyond your means and capacity.
      Thirdly, if you find your neighbours suffering, give them solace. Try to help and make them happy.
    </Quote>
  </Section>

  <!-- What the children prepare -->
  <Section tone="sand" width="narrow" eyebrow="The programme" title="Nava Vidha Bhakthi — the nine paths of devotion">
    <div class="grid gap-8 sm:grid-cols-[1fr_1.3fr] sm:items-center">
      <figure class="reveal">
        <img
          src="/img/easwaramma/nava-vidha-bhakthi-invite.webp"
          alt="The printed invitation for Easwaramma Day 2026, titled Nava Vidha Bhakthi, the Nine Paths of Devotion"
          width="1000"
          height="1400"
          loading="lazy"
          decoding="async"
          class="w-full rounded-2xl shadow-lg shadow-indigo-ink-900/10"
        />
      </figure>

      <div class="rich reveal !mt-0">
        <p>
          The 2026 programme took the nine paths of devotion as its theme — Sravanam, Keertanam, Smaranam, Padasevanam,
          Archanam, Vandanam, Dasyam, Sakhyam and Atmanivedanam — each presented by a different group of children and
          set out in dioramas around the hall.
        </p>
        <p>
          Preparing it asks a real commitment: rehearsals every Saturday afternoon and Sunday for four to five weeks
          before the programme, plus a full run-through on the Friday evening. Alumni return each year to help the
          younger children with transitions and costume changes.
        </p>
        <p>
          It teaches skills that outlast the day itself — self-confidence, patience, teamwork and communication. Many
          of our alumni look back on Easwaramma Day rehearsals with real fondness.
        </p>
      </div>
    </div>
  </Section>

  <!-- Gallery -->
  <Section
    width="wide"
    eyebrow="In pictures"
    title="Easwaramma Day 2026"
    lede={`${easwarammaDay2026.length} photographs from the day at Frisco High School. Select any photograph to view it larger.`}
  >
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      {
        easwarammaDay2026.map((photo) => (
          <li class="reveal">
            <a
              href={`/img/easwaramma-2026/${photo.slug}.webp`}
              data-lightbox
              data-caption={photo.caption}
              class="group block overflow-hidden rounded-xl bg-sand-200 ring-1 ring-sand-200 transition-shadow hover:shadow-lg hover:ring-saffron-300"
            >
              <img
                src={`/img/easwaramma-2026/${photo.slug}-thumb.webp`}
                alt={photo.caption}
                loading="lazy"
                decoding="async"
                class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-8 text-sm text-ink-700">
      Photographs from the center’s own shared album. If you would like a photograph removed, please
      <a href="/contact/" class="font-semibold text-saffron-700 underline underline-offset-4">write to us</a>.
    </p>
  </Section>

  <Lightbox />
</Base>
