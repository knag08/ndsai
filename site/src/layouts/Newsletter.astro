---
import Base from './Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { newsletters, type NewsletterMeta } from '../data/newsletters';
import { site } from '../data/site';

interface Props {
  meta: NewsletterMeta;
}

const { meta } = Astro.props;

const index = newsletters.findIndex((item) => item.slug === meta.slug);
const newer = index > 0 ? newsletters[index - 1] : undefined;
const older = index < newsletters.length - 1 ? newsletters[index + 1] : undefined;
---

<Base title={`${meta.title} · Newsletter`} description={meta.summary} image={meta.cover}>
  <section class="border-b border-sand-200 bg-indigo-ink-900">
    <div class="absolute inset-x-0 h-0.5 bg-gradient-to-r from-saffron-500 via-saffron-300 to-saffron-500"></div>
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm">
        <a href="/newsletter/" class="text-indigo-ink-200 underline decoration-saffron-400/60 underline-offset-4 hover:text-white">
          Newsletter
        </a>
      </nav>
      <p class="eyebrow mt-5 !text-saffron-300">{meta.edition} &middot; {meta.date}</p>
      <h1 class="mt-3 font-display text-4xl font-semibold !text-white sm:text-5xl">{meta.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-indigo-ink-100">{meta.summary}</p>

      <ul class="mt-7 flex flex-wrap gap-2">
        {
          meta.topics.map((topic) => (
            <li class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-indigo-ink-100">{topic}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <Section width="narrow">
    <div class="rich newsletter-body reveal">
      <p class="!text-lg !text-indigo-ink-900">Om Sri Sai Ram,</p>
      <slot />
    </div>

    <!-- Footer of every edition, as printed -->
    <div class="reveal mt-14 rounded-2xl bg-sand-100 p-7">
      <h2 class="font-display text-xl font-semibold">Join the mailing list</h2>
      <p class="mt-2 leading-relaxed text-ink-700">
        Do you know a parent who would like to receive the newsletter? Write to us and we will add them.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <Button href={`mailto:${site.email.newsletter}`}>{site.email.newsletter}</Button>
        {meta.original && (
          <Button href={meta.original} variant="secondary">View the original email</Button>
        )}
      </div>
    </div>

    <!-- Prev / next -->
    <nav class="mt-12 grid gap-4 sm:grid-cols-2" aria-label="Other editions">
      {
        older ? (
          <a
            href={`/newsletter/${older.slug}/`}
            class="group rounded-2xl bg-white p-6 ring-1 ring-sand-200 transition-all hover:-translate-y-0.5 hover:ring-saffron-300"
          >
            <p class="text-[0.68rem] font-semibold tracking-[0.14em] text-saffron-700 uppercase">Earlier edition</p>
            <p class="mt-2 font-display text-xl font-semibold group-hover:text-saffron-700">{older.title}</p>
            <p class="mt-1 text-sm text-ink-700">{older.date}</p>
          </a>
        ) : (
          <div />
        )
      }
      {
        newer && (
          <a
            href={`/newsletter/${newer.slug}/`}
            class="group rounded-2xl bg-white p-6 text-right ring-1 ring-sand-200 transition-all hover:-translate-y-0.5 hover:ring-saffron-300 sm:col-start-2"
          >
            <p class="text-[0.68rem] font-semibold tracking-[0.14em] text-saffron-700 uppercase">Later edition</p>
            <p class="mt-2 font-display text-xl font-semibold group-hover:text-saffron-700">{newer.title}</p>
            <p class="mt-1 text-sm text-ink-700">{newer.date}</p>
          </a>
        )
      }
    </nav>
  </Section>
</Base>

<style is:global>
  /* Figures and callouts used inside newsletter bodies. */
  .newsletter-body figure {
    margin-block: 2.25rem;
  }
  .newsletter-body figure img {
    width: 100%;
    border-radius: 1rem;
    box-shadow: 0 18px 40px -24px rgb(30 42 90 / 0.35);
  }
  .newsletter-body figcaption {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--color-ink-700);
  }
  .newsletter-body h2:first-of-type {
    margin-top: 2.4em;
  }
</style>
