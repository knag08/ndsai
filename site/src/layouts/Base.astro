---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Path to an image under /img used for link previews. */
  image?: string;
  /** Suppress the " · North Dallas Sathya Sai BalVikas" suffix on the home page. */
  bareTitle?: boolean;
}

const { title, description, image = '/img/swami/swami-blessing.webp', bareTitle = false } = Astro.props;

const pageTitle = bareTitle ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.name,
  alternateName: 'NDSAI',
  url: site.url,
  email: site.email.general,
  description: site.tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '14275 Rolater Rd',
    addressLocality: 'Frisco',
    addressRegion: 'TX',
    postalCode: '75035',
    addressCountry: 'US',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!--
      The SSIO emblem, the same mark as in the header. favicon.ico is listed
      first and also sits at the root, because browsers request /favicon.ico
      whether or not it is declared, and a 404 there is what leaves a tab blank.
    -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1e2a5a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Gates the scroll-reveal styles on scripting being available. Inline and in
         <head> so it lands before first paint and never causes a flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-100 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-indigo-ink-900 focus:shadow-lg"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      // Reveal-on-scroll. Elements start hidden only when the class is present,
      // so content stays visible if this script never runs.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      const show = (el: Element) => el.classList.add('is-visible');

      if (targets.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => observer.observe(el));

        // Safety net: anything already on screen a moment after load is shown
        // regardless, so a missed callback can never strand content at opacity 0.
        setTimeout(() => {
          for (const el of targets) {
            if (el.getBoundingClientRect().top < window.innerHeight) show(el);
          }
        }, 900);
      } else {
        targets.forEach(show);
      }
    </script>
  </body>
</html>
