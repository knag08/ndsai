---
interface Props {
  title: string;
  href?: string;
  eyebrow?: string;
  image?: string;
  imageAlt?: string;
  class?: string;
}

const { title, href, eyebrow, image, imageAlt = '', class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'reveal group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-sand-200 transition-all duration-300',
    href && 'hover:-translate-y-1 hover:ring-saffron-300 hover:shadow-xl hover:shadow-indigo-ink-900/8',
    className,
  ]}
>
  {
    image && (
      <div class="aspect-[16/10] overflow-hidden bg-sand-200">
        <img
          src={image}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    {eyebrow && <p class="text-[0.68rem] font-semibold tracking-[0.14em] text-saffron-700 uppercase">{eyebrow}</p>}
    <h3 class:list={['font-display text-xl font-semibold', eyebrow && 'mt-2']}>{title}</h3>
    <div class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-700">
      <slot />
    </div>
    {
      href && (
        <p class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-saffron-700">
          Read more
          <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10m0 0L8 3m4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </p>
      )
    }
  </div>
</Tag>
