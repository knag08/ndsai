---
import { nav, site } from '../data/site';

const year = new Date().getFullYear();

/** Flatten the nav into three tidy sitemap columns. */
const columns = [
  { heading: 'The Center', links: [nav[0], nav[1], { label: 'Bhajans', href: '/bhajans/' }, { label: 'Contact', href: '/contact/' }] },
  { heading: 'Bal Vikas', links: nav[2].children! },
  { heading: 'Seva & Media', links: [...nav[3].children!, ...nav[5].children!] },
];
---

<footer class="mt-24 bg-indigo-ink-900 text-indigo-ink-100">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div>
        <div class="flex items-center gap-3">
          <img src="/img/brand/ssio-emblem.webp" alt="" width="48" height="48" class="h-12 w-12" loading="lazy" />
          <p class="font-display text-xl font-semibold text-white">{site.name}</p>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-indigo-ink-200">
          A 501(c)(3) non-profit organisation in Frisco, Texas. We provide a forum to learn and practise the
          teachings of Sri Sathya Sai Baba through study, devotional singing and service to the community.
        </p>
        <address class="mt-5 space-y-1 text-sm not-italic text-indigo-ink-200">
          <p>{site.address}</p>
          <p>
            <a href={`mailto:${site.email.general}`} class="underline decoration-saffron-400/70 underline-offset-4 hover:text-white">
              {site.email.general}
            </a>
          </p>
        </address>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="text-[0.7rem] font-semibold tracking-[0.16em] text-saffron-300 uppercase">{column.heading}</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-indigo-ink-200 transition-colors hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-xs text-indigo-ink-300 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="/archive/" class="transition-colors hover:text-white">Previous website (archive)</a>
        <a href={`mailto:${site.email.newsletter}`} class="transition-colors hover:text-white">
          Join the newsletter
        </a>
      </p>
    </div>
  </div>
</footer>
